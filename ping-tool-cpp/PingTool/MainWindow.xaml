<!-- MainWindow.xaml — 主窗口 UI 布局 -->
<Window
    x:Class="PingTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ping Tool">

    <Grid Background="#E8F4FD">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <TextBlock Grid.Row="0"
                   Text="🔵 Ping &amp; Tailscale 工具"
                   FontSize="20" FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="16,12,16,8"/>

        <!-- 可滚动内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,0,16,0">

                <!-- ═══ 目标管理卡片 ═══ -->
                <Border Background="White" CornerRadius="12"
                        BorderBrush="#CBD5E1" BorderThickness="1"
                        Padding="14,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="📋 我的目标" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1E293B" Margin="0,0,0,8"/>

                        <!-- 添加行 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="TargetInput"
                                     PlaceholderText="输入 IP 或域名，例如 8.8.8.8"
                                     Width="300" Height="32" Margin="0,0,8,0"
                                     FontSize="14"/>
                            <Button x:Name="AddButton"
                                    Content="➕ 添加"
                                    Width="70" Height="32"
                                    Background="#3B82F6" Foreground="White"
                                    CornerRadius="6"
                                    Click="OnAddTarget"/>
                        </StackPanel>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="#CBD5E1" Margin="0,0,0,6"/>

                        <!-- 目标行容器（代码动态填充） -->
                        <StackPanel x:Name="RowsPanel" Margin="0,0,0,4"/>

                        <!-- 空状态提示 -->
                        <TextBlock x:Name="EmptyLabel"
                                   Text="还没有目标，在上方输入后点击「添加」"
                                   FontSize="12" Foreground="#64748B"
                                   Margin="4,4,0,8"/>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="#CBD5E1" Margin="0,4,0,8"/>

                        <!-- 启停按钮 -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartAllBtn"
                                    Content="▶ 开始 Ping 全部"
                                    Width="150" Height="36"
                                    Background="#3B82F6" Foreground="White"
                                    CornerRadius="8"
                                    FontSize="14"
                                    Click="OnStartAll"
                                    Margin="0,0,10,0"/>
                            <Button x:Name="StopAllBtn"
                                    Content="⏹ 停止全部"
                                    Width="120" Height="36"
                                    Background="Transparent" Foreground="#EF4444"
                                    BorderBrush="#EF4444" BorderThickness="1"
                                    CornerRadius="8"
                                    FontSize="14"
                                    Click="OnStopAll"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ Tailscale 管理卡片 ═══ -->
                <Border Background="White" CornerRadius="12"
                        BorderBrush="#CBD5E1" BorderThickness="1"
                        Padding="14,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="🔄 Tailscale 管理" FontSize="16"
                                   FontWeight="SemiBold" Foreground="#1E293B"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RestartTsBtn"
                                    Content="🔄 重启 Tailscale"
                                    Width="140" Height="36"
                                    Background="#3B82F6" Foreground="White"
                                    CornerRadius="8" FontSize="14"
                                    Click="OnRestartTailscale"/>
                            <TextBlock x:Name="TsStatusLabel"
                                       FontSize="12" Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Height="28" Padding="16,4">
            <Grid>
                <TextBlock x:Name="StatusBar" Text="就绪"
                           FontSize="12" Foreground="#64748B"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="v1.1 C++" FontSize="12" Foreground="#64748B"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
